{
  "$schema": "https://anthropic.com/claude-code/plugin.schema.json",
  "name": "tsk",
  "version": "0.1.0",
  "description": "Token Saving Kit — 自动压缩输入/输出/历史，降低 Claude Code 会话的 token 消耗",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "tsk hook PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "tsk hook PostToolUse"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tsk hook SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tsk hook UserPromptSubmit"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tsk hook PreCompact"
          }
        ]
      }
    ]
  }
}